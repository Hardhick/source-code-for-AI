        /* Rendering Site to Preview & Code View */
        function renderSite(html) {
            const iframe = document.getElementById('previewFrame');
            const codeText = document.getElementById('codeText');
            
            // Set frame srcdoc
            iframe.srcdoc = html;

            // Set raw code text
            codeText.textContent = html;

            // Switch display view
            document.getElementById('emptyState').classList.add('hidden');
            document.getElementById('previewWrapper').classList.remove('hidden');
            switchTab('preview');
        }

        /* Status & Progress Helper */
        function updateStatus(show, percent, stepText) {
            const container = document.getElementById('statusContainer');
            const progressBar = document.getElementById('progressBar');
            const percentageText = document.getElementById('progressPercentage');
            const step = document.getElementById('statusStep');
            const btn = document.getElementById('generateBtn');

            if (show) {
                container.classList.remove('hidden');
                progressBar.style.width = `${percent}%`;
                percentageText.innerText = `${percent}%`;
                step.innerText = stepText;
                btn.disabled = true;
                btn.classList.add('opacity-50', 'cursor-not-allowed');
            } else {
                btn.disabled = false;
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
                setTimeout(() => container.classList.add('hidden'), 1000);
            }
        }

        /* Export & Clipboard Helper Functions */
        function copyToClipboard() {
            if (!state.generatedHtml) {
                alert('No code generated yet to copy.');
                return;
            }
            navigator.clipboard.writeText(state.generatedHtml).then(() => {
                alert('HTML Code copied to clipboard!');
            });
        }

        function exportCode() {
            if (!state.generatedHtml) {
                alert('Please generate a website before exporting.');
                return;
            }
            const blob = new Blob([state.generatedHtml], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'generated-website.html';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function openInNewTab() {
            if (!state.generatedHtml) {
                alert('Please generate a website first.');
                return;
            }
            const blob = new Blob([state.generatedHtml], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            window.open(url, '_blank');
        }

        function resetAll() {
            document.getElementById('promptInput').value = '';
            document.getElementById('promptCharCount').innerText = '0 chars';
            state.generatedHtml = '';
            document.getElementById('previewWrapper').classList.add('hidden');
            document.getElementById('codeWrapper').classList.add('hidden');
            document.getElementById('emptyState').classList.remove('hidden');
